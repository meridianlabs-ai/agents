+# Auto-reviews PRs on open (PRs here target main, which carries this file, so
+# the pull_request trigger fires — unlike the pristine-base fork; release-please
 # PRs are skipped, gated in the reusable workflow) and on demand via @review.
 name: Review
 
@@ -20,10 +20,10 @@ on:
 jobs:
   review:
     # Run on PR events (skipping drafts — they get reviewed via
