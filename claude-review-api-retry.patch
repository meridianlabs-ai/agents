+          api() {
+            local out
+            if out=$(gh api "$@" 2>/dev/null); then printf '%s' "$out"; return 0; fi
+            sleep 5
+            if out=$(gh api "$@" 2>/dev/null); then printf '%s' "$out"; return 0; fi
+            return 1
+          }
